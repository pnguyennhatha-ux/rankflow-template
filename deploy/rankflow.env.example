# Copy to /etc/rankflow/rankflow.env and chmod 600.
# Generate unique values with: openssl rand -hex 32
RANKFLOW_DB=/var/lib/rankflow/rankflow.sqlite3
RANKFLOW_HOST=127.0.0.1
RANKFLOW_PORT=8787
RANKFLOW_WORKER_TOKEN=CHANGE_ME_32_PLUS_RANDOM_CHARS
RANKFLOW_ADMIN_TOKEN=CHANGE_ME_DIFFERENT_32_PLUS_RANDOM_CHARS
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_TOKEN=
RANKFLOW_TIMEZONE=Asia/Bangkok
RANKFLOW_LIVE_ENABLED=0
RANKFLOW_REQUEST_MAX_AGE_HOURS=2
RANKFLOW_SCHEDULE_GRACE_MINUTES=30
