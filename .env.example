# RankFlow backend config. Copy to .env (repo root) and fill in. Never commit .env.
# --- Lark app (Developer Console > your custom app > Credentials) ---
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
# Secret: set here or export in the environment; never paste it into the extension or the block.
LARK_APP_SECRET=
# Base token = the part after /base/ in the Base URL
LARK_BASE_TOKEN=
# https://open.larksuite.com (Lark international) or https://open.feishu.cn (Feishu)
LARK_DOMAIN=https://open.larksuite.com

# --- Block (Table View Extension) — public ids, read by block-ui build ---
BLOCK_TYPE_ID=blk_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional "Open Base" link shown in the block
RANKFLOW_BASE_URL=
RANKFLOW_DEFAULT_WATCHLIST=default
RANKFLOW_ORG_LABEL=My Company

# --- Crawl defaults ---
MARKETPLACE=amazon.com
ZIP=10001
# organic results scanned per keyword
DEPTH=190

# --- Backend server ---
PORT=8787
RANKFLOW_HOST=127.0.0.1
RANKFLOW_DB=data/rankflow.sqlite3
RANKFLOW_TIMEZONE=Asia/Bangkok
# Generate with: openssl rand -hex 32
RANKFLOW_WORKER_TOKEN=
RANKFLOW_ADMIN_TOKEN=
# 0 = offline/dry (no Lark writes). Set 1 only after the acceptance run.
RANKFLOW_LIVE_ENABLED=0

# Optional: pin table ids instead of resolving by name
# RANKFLOW_TABLE_ITEMS= RANKFLOW_TABLE_WATCHLISTS= RANKFLOW_TABLE_SNAPSHOTS= RANKFLOW_TABLE_RUNS= RANKFLOW_TABLE_REQUESTS=
